#!/bin/sh
# This exact immutable HTTPS script is the bootstrap trust boundary.
# It checks the pinned runtime bytes before executing downloaded code.
main() (
    set -eu
    umask 077
    fail() { printf '%s\n' "$*" >&2; exit 1; }
    [ "$#" -eq 0 ] || fail 'The installer takes no arguments. Use launcher --help after installation.'
    [ -n "${HOME:-}" ] || fail 'HOME is required.'
    os=$(uname -s)
    arch=$(uname -m)
    case "$arch" in arm64|aarch64) arch=aarch64;; x86_64) :;; *) fail "Unsupported architecture: $arch";; esac
    case "$os" in
        Darwin)
            [ "$(sw_vers -productVersion | cut -d . -f 1)" -ge 15 ] || fail 'macOS 15+ is required.'
            if [ "$(sysctl -n hw.optional.arm64 2>/dev/null || true)" = 1 ]; then arch=aarch64; fi
            suffix=apple-darwin ;;
        Linux)
            libc=$(getconf GNU_LIBC_VERSION 2>/dev/null) || fail 'Linux glibc 2.28+ is required; musl is unsupported.'
            version=${libc#glibc }
            major=${version%%.*}; minor=${version#*.}; minor=${minor%%.*}
            [ "$major" -gt 2 ] || { [ "$major" -eq 2 ] && [ "$minor" -ge 28 ]; } || fail 'Linux glibc 2.28+ is required.'
            suffix=unknown-linux-gnu ;;
        *) fail "Unsupported operating system: $os" ;;
    esac
    target=$arch-$suffix
    case "$target" in
@TARGET_CASES@
        *) fail 'This preview does not contain your native platform. Request its profile or all.' ;;
    esac
    directory=$(mktemp -d "${TMPDIR:-/tmp}/fluxcope-preview.XXXXXXXX")
    trap 'rm -rf "$directory"' EXIT HUP INT TERM
    directory=$(cd "$directory" && pwd -P)
    archive=$directory/client.tar.xz
    url='https://github.com/LorNtz/fluxcope/releases/download/v0.0.0-preview.@ID@'
    printf 'Downloading installer runtime for preview @ID@ (%s)…\n' "$target"
    curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
        --max-filesize 268435456 "$url/fluxcope-preview-client-$target.tar.xz" -o "$archive"
    if command -v sha256sum >/dev/null 2>&1; then actual=$(sha256sum "$archive"); else actual=$(shasum -a 256 "$archive"); fi
    [ "${actual%% *}" = "$checksum" ] || fail 'Private runtime checksum mismatch; nothing was installed.'
    tar -xJf "$archive" -C "$directory"
    "$directory/preview-client" install '@ID@' --client-archive "$archive"
)
main "$@"
